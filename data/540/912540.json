      "othercredits": {
        "arabic": "تأليف وتوزيع Tadayoshi Makino، Zhenlan Kang، Akihiko Narita، Yuko Komiyama\r\nAdditional وأعمال إضافية لـ Nashville Music Scoring Orchestra، Ikuko، Daisuke Miyazaki، وChiaki Yoshiike\r\nوكلمات إضافية لـ Kaname Fujioka",
        "brazilian": "Composição e arranjo de Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nParticipações adicionais de Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki e Chiaki Yoshiike\r\nLetras adicionais de Kaname Fujioka",
        "bulgarian": "",
        "czech": "",
        "danish": "Komponeret og arrangeret af Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nMed Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, & Chiaki Yoshiike\r\nSupplerende tekst af Kaname Fujioka",
        "dutch": "Gecomponeerd en gearrangeerd door Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nAdditionele uitvoeringen door het Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki en Chiaki Yoshiike\r\nAdditionele songteksten van Kaname Fujioka",
        "english": "[b]Orchestrator & Conductor:[/b] Paul D. Taylor, Tomomichi Takeoka \r\n[b]Orchestra:[/b] Nashville Music Scoring Orchestra \r\n[b]Vocalist:[/b] Ikuko \r\n[b]Guitar:[/b] Daisuke Miyazaki \r\n[b]Bass:[/b] Chiaki Yoshiike \r\n[b]Lyricist:[/b] Kaname Fujioka",
        "finnish": "Sävellys ja sovitus: Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nMuut esittäjät: Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki ja Chiaki Yoshiike\r\nMuut laulajat: Kaname Fujioka",
        "french": "Composition et arrangements : Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nEnregistrements additionnels : le Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki & Chiaki Yoshiike\r\nParoles additionnelles : Kaname Fujioka",
        "german": "Komponiert und arrangiert von Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nZusätzliche Darbietungen von Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, & Chiaki Yoshiike\r\nZusätzliche Liedtexte von Kaname Fujioka",
        "greek": "",
        "hungarian": "",
        "italian": "Composizione e arrangiamento a cura di Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nAltre prestazioni a cura di: Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki e Chiaki Yoshiike\r\nAltri testi a cura di Kaname Fujioka",
        "japanese": "[b]Orchestrator & Conductor:[/b] Paul D. Taylor, 竹岡 智行\r\n[b]Orchestra:[/b] Nashville Music Scoring Orchestra \r\n[b]Vocalist:[/b] Ikuko \r\n[b]Guitar:[/b] 宮崎 大介\r\n[b]Bass:[/b] 吉池 千秋\r\n[b]Words:[/b] 藤岡 要",
        "koreana": "Composed and arranged by Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nAdditional performances by the Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, & Chiaki Yoshiike\r\nAdditional lyrics by Kaname Fujioka",
        "latam": "",
        "norwegian": "Komponert og arrangert av Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nAdditional performances by the Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki og Chiaki Yoshiike\r\nEkstra tekst av Kaname Fujioka",
        "polish": "Kompozycja i aranżacja: Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nUdział w nagraniach: Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki i Chiaki Yoshiike\r\nDodatkowe teksty: Kaname Fujioka",
        "portuguese": "Composição e arranjo por Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nInterpretações adicionais pela Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki e Chiaki Yoshiike\r\nLetras adicionais por Kaname Fujioka",
        "romanian": "",
        "russian": "Музыка и аранжировка: Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nПри участии: Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki и Chiaki Yoshiike\r\nДополнительный текст: Kaname Fujioka",
        "schinese": "作曲及编曲： Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\n特别演出： Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, & Chiaki Yoshiike\r\n特别作词： Kaname Fujioka",
        "spanish": "Composición y arreglos de Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nInterpretaciones adicionales de la Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki y Chiaki Yoshiike\r\nLetras adicionales de Kaname Fujioka",
        "swedish": "Komponerat och arrangerat av Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\nMed framföranden av Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, och Chiaki Yoshiike\r\nOch texter av Kaname Fujioka",
        "tchinese": "作曲及編曲： Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama\r\n特別演出： Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki, & Chiaki Yoshiike\r\n特別作詞： Kaname Fujioka",
        "thai": "",
        "turkish": "Tadayoshi Makino, Zhenlan Kang, Akihiko Narita, Yuko Komiyama tarafından bestelenip düzenlenmiştir\r\nEk performanslar: Nashville Music Scoring Orchestra, Ikuko, Daisuke Miyazaki ve Chiaki Yoshiike\r\nEk sözler: Kaname Fujioka",
        "ukrainian": "",
        "vietnamese": ""
      }
